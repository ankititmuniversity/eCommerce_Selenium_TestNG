pipeline {
    agent { label 'ansible-node' }
    stages {
        stage('Check Ansible') {
            steps {
                sh 'ansible --version'
            }
        }

        stage('Fetch Artifact') {
            steps {
                // Copy artifact from build workspace or artifact repo
                sh 'cp C:/Users/ankit/.jenkins/workspace/eCommerce_CI_Demo/e-commerce/target/e-commerce-0.0.1-SNAPSHOT.jar ./app.jar'
            }
        }

        stage('Deploy to QA') {
            steps {
                sh 'ansible-playbook -i inventories/qa.ini deploy.yml --extra-vars "artifact=app.jar env=qa"'
            }
        }

        stage('Approval for Prod') {
            steps {
                input message: "Deploy to Production?", ok: "Yes, Deploy"
            }
        }

        stage('Deploy to Prod') {
            steps {
                sh 'ansible-playbook -i inventories/prod.ini deploy.yml --extra-vars "artifact=app.jar env=prod"'
            }
        }
    }

    post {
        success {
            echo "Release pipeline completed successfully!"
        }
        failure {
            echo "Release pipeline failed!"
        }
    }
}    
