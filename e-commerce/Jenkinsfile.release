pipeline {
    agent any
    
    stages {
        stage('Fetch Artifact') {
            steps {
                copyArtifacts(
                    projectName: 'MyFirst_CICD_Pipeline',   // name of your build job
                    selector: lastSuccessful(),
                    filter: 'e-commerce/target/*.jar',
                    target: 'app/'
                )
            }
        }
        //this ties your release pipeline to a specific Jenkins controller path. 
        // stage('Fetch Artifact') {
        //     steps {
        //         sh 'cp C:/Users/ankit/.jenkins/workspace/MyFirst_CICD_Pipeline/e-commerce/target/e-commerce-0.0.1-SNAPSHOT.jar ./app.jar'
        //     }
        // }

        stage('Check Ansible') {
            steps {
                sh 'ansible --version'
            }
        }

        stage('Fetch Artifact') {
            steps {
                // Copy artifact from build workspace or artifact repo
                sh 'cp C:/Users/ankit/.jenkins/workspace/MyFirst_CICD_Pipeline/e-commerce/target/e-commerce-0.0.1-SNAPSHOT.jar ./app.jar'
            }
        }

        stage('Deploy to QA') {
            steps {
                sh 'ansible-playbook -i inventories/qa.ini deploy.yml --extra-vars "artifact=app.jar env=qa"'
            }
        }

        stage('Approval for Prod') {
            steps {
                input message: "Deploy to Production?", ok: "Yes, Deploy"
            }
        }

        stage('Deploy to Prod') {
            steps {
                sh 'ansible-playbook -i inventories/prod.ini deploy.yml --extra-vars "artifact=app.jar env=prod"'
            }
        }
    }

    post {
        success {
            echo "Release pipeline completed successfully!"
        }
        failure {
            echo "Release pipeline failed!"
        }
    }
